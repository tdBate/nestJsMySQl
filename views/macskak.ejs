<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <table>
        <% data.forEach(element=> {
            %> <tr>
                <td>
                    <%=element.id%>
                </td>
                <td>
                    <%=element.suly%>
                </td>
                <td>
                    <%= element.szem_szin%>
                </td>
                <td>
                    <%=element.gazdi_id%>
                </td>
                <td>
                    <%=element.jatek_id%>
                </td>

                <td>
                    <button onclick="window.location.href='deleteMacska?id=<%= element.id %>'">Törlés</button>
                </td>
            </tr>
            <% }); %>
    </table>
</body>

</html>